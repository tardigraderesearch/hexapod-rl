        <mxCell id="s1" value="&lt;b&gt;Measured robot&lt;/b&gt;&lt;br&gt;leg lengths 48 / 78.5 / 139 mm, 5.53 kg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b78c2;fontSize=13;" vertex="1" parent="1">
